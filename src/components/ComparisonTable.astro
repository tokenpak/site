---
/*
 * Open-source feature inventory. The historical "OSS vs Pro" two-column form
 * is parked, so Pro is not part of this inventory. To restore the Pro column,
 * revert to the row schema with `oss` and `pro` keys and re-add the header
 * cells.
 */
interface Row {
  feature: string;
  status: string;
}

interface Props {
  rows?: Row[];
}

const defaultRows: Row[] = [
  { feature: 'Explicit context tools; conversation history preserved by default', status: 'Shipped' },
  { feature: 'Local proxy at 127.0.0.1',                           status: 'Shipped' },
  { feature: 'Tested SDK adapters: OpenAI SDK, Anthropic SDK, LiteLLM', status: 'Shipped' },
  { feature: 'First-class integrations: Claude Code and Codex', status: 'Shipped' },
  { feature: 'Client integrations — compatibility targets: Cursor, Cline, Continue, Aider', status: 'Unverified' },
  { feature: 'Routing policy configuration and observe-mode records', status: 'Shipped; enforcement not active by default' },
  { feature: 'Savings Ledger + local telemetry',                   status: 'Shipped' },
  { feature: 'Vault indexing + semantic search',                   status: 'Shipped' },
  { feature: 'Local dashboard (TUI + web)',                        status: 'Shipped' },
  { feature: 'A/B testing + request replay',                       status: 'Shipped' },
  { feature: '57 built-in compression recipes',                    status: 'Shipped' },
  { feature: 'Spend Guard — pre-send circuit breaker (context-window limits on by default; dollar and rolling caps opt-in)', status: 'Shipped' },
  { feature: 'TIP-1.0 protocol contracts + conformance gate',      status: 'Shipped' },
  { feature: 'Pak recall data plane (storage, FTS, inspect)',      status: 'Shipped' },
  { feature: 'PAKPlan preview / explain / report (read-only)',     status: 'Shipped' },
];

const { rows = defaultRows } = Astro.props;
---
<div
  class="overflow-x-auto rounded-card border border-tp-rule"
  role="region"
  aria-label="Open-source feature inventory"
  tabindex="0"
>
  <table class="w-full text-small">
    <thead class="bg-tp-paper">
      <tr>
        <th class="text-left font-semibold px-4 py-3">Feature</th>
        <th class="text-left font-semibold px-4 py-3 w-32">Status</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="border-t border-tp-rule">
          <td class="px-4 py-3 text-tp-ink">{row.feature}</td>
          <td class="px-4 py-3 text-tp-ink">{row.status}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
