---
import { config } from '../lib/config';

interface Props {
  tagline?: string;
  lede?: string;
}

const {
  tagline = 'Your agent starts every session not knowing what you already decided.',
  lede = 'TokenPak is a local proxy. Once you have indexed a vault, then on every eligible request — before the model is given the task — it searches that vault, fits the best matches to a token budget, and splices them into the request. Retrieved content becomes part of what your provider receives, and TokenPak shows you exactly what it added.',
} = Astro.props;
---
<section class="mx-auto max-w-prose-wide px-6 pt-16 pb-12">
  <div class="grid grid-cols-1 md:grid-cols-[2fr,1fr] gap-10 items-center">
    <div>
      <p class="text-caption text-tp-mute uppercase tracking-wide mb-2">TokenPak — the open logistics layer for AI context</p>
      <h1 class="text-display leading-tight">{tagline}</h1>
      <p class="mt-4 text-body text-tp-ink max-w-prose">{lede}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={config.cta_urls.get_started}
          class="inline-flex items-center rounded-card bg-tp-accent px-5 py-3 font-semibold text-tp-ink no-underline"
        >
          Get Started
        </a>
        <a
          href={config.cta_urls.view_on_github}
          class="inline-flex items-center rounded-card border border-tp-rule px-5 py-3 font-semibold text-tp-ink no-underline hover:border-tp-accent"
        >
          View on GitHub
        </a>
      </div>
    </div>
    <aside class="rounded-card border border-tp-rule p-6 bg-tp-paper">
      <p class="text-caption text-tp-mute uppercase tracking-wide">What the receipt shows</p>
      <p class="mt-2 font-mono text-small text-tp-ink">injected 3 sources · 412 tokens</p>
      <p
        class="mt-1 font-mono font-bold text-h1 inline-block px-2 rounded-input"
        style="background-color: var(--tp-signal-value); color: var(--tp-ink);"
      >
        before the model saw it
      </p>
      <p class="mt-2 text-caption text-tp-mute">Illustrative. Every injection names its sources and its token cost, so you can check what was added rather than trust that it was right.</p>
    </aside>
  </div>
</section>
