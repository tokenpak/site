---
import { config } from '../lib/config';

interface Props {
  tagline?: string;
  lede?: string;
}

const {
  tagline = 'Know how far your agent can go.',
  lede = 'TokenPak is a local proxy for coding agents that records each request and shows how far the session can go: measured usage, estimated cost, burn and runway.',
} = Astro.props;
---
<section class="mx-auto max-w-prose-wide px-6 pt-16 pb-12">
  <div class="grid grid-cols-1 md:grid-cols-[2fr,1fr] gap-10 items-center">
    <div>
      <p class="text-small text-tp-mute mb-2">TokenPak is the open logistics layer for AI context.</p>
      <h1 class="text-display leading-tight text-balance">{tagline}</h1>
      <p class="mt-4 text-body text-tp-ink max-w-prose">{lede}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={config.cta_urls.get_started}
          class="inline-flex items-center rounded-card bg-tp-accent px-5 py-3 font-semibold text-tp-ink no-underline"
        >
          Get Started
        </a>
        <a
          href={config.cta_urls.view_on_github}
          class="inline-flex items-center rounded-card border border-tp-rule px-5 py-3 font-semibold text-tp-ink no-underline hover:border-tp-accent"
        >
          View on GitHub
        </a>
      </div>
    </div>
    {/* What ships today versus what is planned. The direction line (the
        heading) is only ever shown next to this statement. */}
    <dl class="rounded-card border border-tp-rule p-6 bg-tp-paper">
      <dt class="text-caption text-tp-mute uppercase tracking-wide">Today</dt>
      <dd class="mt-1 text-small text-tp-ink">
        Request records and receipts, a session trip computer whose forecasts
        are ranges, not guarantees, and appear only once a model has enough
        local history, Spend Guard limits and explicit context tools.
      </dd>
      <dt class="mt-4 text-caption text-tp-mute uppercase tracking-wide">Planned</dt>
      <dd class="mt-1 text-small text-tp-ink">
        Calibrated forecasts for more model and effort combinations, and Pro
        reroute recommendations once calibration evidence exists. Any
        automation comes later, and separately gated.
      </dd>
    </dl>
  </div>
</section>
