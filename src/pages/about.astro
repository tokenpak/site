---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleCard from '../components/ModuleCard.astro';
import CTASection from '../components/CTASection.astro';
import { config } from '../lib/config';

// All content sourced from Constitution §1 (mission), §2 (identity),
// §13 (TokenPak / TIP / MCP), 01 §11 (multi-repo topology). No
// invented narrative; no founder mythology per kickoff §3 PR#10.

const surfaces = [
  {
    label: 'Package',
    title: 'tokenpak',
    body: 'The Python package — proxy, companion, CLI, integrations. Published to PyPI; Apache 2.0. What a user installs.',
  },
  {
    label: 'Docs',
    title: 'docs.tokenpak.ai',
    body: 'MkDocs-rendered user docs + TIP-1.0 normative spec. Sourced from the tokenpak/docs repo.',
  },
  {
    label: 'Registry',
    title: 'tokenpak/registry',
    body: 'Machine-readable TIP-1.0 schemas, manifest schemas, capability catalog, adapter + plugin manifests. Published as tokenpak-tip-validator on PyPI.',
  },
  {
    label: 'Site',
    title: 'tokenpak.ai',
    body: 'This page — the public marketing surface. Astro static site; source in tokenpak/site.',
  },
];
---
<BaseLayout title="About — TokenPak" description="Local request records and explicit context tools. The default proxy preserves conversation turns and does not promise token savings.">
  <section class="mx-auto max-w-prose-wide px-6 pt-16 pb-8">
    <p class="text-caption text-tp-mute uppercase tracking-wide mb-2">About</p>
    <h1>Local request records and explicit context tools.</h1>
    <p class="mt-4 text-tp-mute text-small">
      The default proxy preserves conversation turns. Explicit tools can reduce
      eligible content; byte-preserved requests report zero product-attributed
      reduction. Provider cache reuse is a separate measurement.
    </p>
    <p class="mt-6 text-body">
      TokenPak is the local layer between a developer's LLM client and the provider.
      It forwards requests and records available usage. Provider-bound prompts and
      credentials still travel to the configured provider; TokenPak operates no cloud relay.
    </p>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>Product identity</h2>
    <p class="mt-4 text-body">
      <strong>TokenPak is a local LLM proxy with request records and explicit context tools.</strong>
      The default forwarding path preserves conversation turns. Integration support
      is tiered; see the tested SDK adapters, first-class integrations and compatibility
      targets on the <a href="/open-source">open-source page</a>.
    </p>
    <p class="mt-4 text-body">
      <strong>Prompt Packing</strong> describes explicit context operations.
      It does not mean that every proxy request is shortened. The <strong>Savings
      Ledger</strong> records available usage and cache attribution; a request can
      correctly show zero savings.
    </p>
    <p class="mt-4 text-body">
      Prompt Packing is one job, not the whole story. Routing, caching, the Savings Ledger, and
      a local dashboard all ship in the same package — because a team running agents in production
      needs all four at the same layer.
    </p>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>TIP-1.0 — the TokenPak Integration Protocol</h2>
    <p class="mt-4 text-body">
      TokenPak is the <strong>reference implementation</strong> of the TokenPak Integration
      Protocol, version 1.0 — a small specification that defines what TokenPak-compatible behavior
      means: canonical headers, metadata fields, telemetry event schemas, capability labels,
      manifest shapes. TIP is a profile/spec, not a transport; the normative text lives in the
      docs repo and the machine-readable schemas live in the registry repo.
    </p>
    <p class="mt-4 text-body text-tp-mute">
      TokenPak is designed to compose with <a href="https://modelcontextprotocol.io/">MCP (Model Context Protocol)</a>-based
      workflows. MCP and TIP are different layers: MCP is a transport for tool and context
      exchange; TIP is TokenPak's semantic contract for packing, routing, cost, and telemetry.
    </p>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>Where things live</h2>
    <p class="mt-2 text-tp-mute">Four public surfaces. Each owns one concern.</p>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {surfaces.map((s) => <ModuleCard label={s.label} title={s.title} body={s.body} />)}
    </div>
    <p class="mt-6 text-small">
      Source on <a href={config.github_repo}>github.com/tokenpak</a> ·
      Published on <a href={config.pypi_repo}>PyPI</a> ·
      Docs at <a href={config.cta_urls.read_docs}>docs.tokenpak.ai</a>.
    </p>
  </section>

  <CTASection heading="Ready to try it?" body={`pip install ${config.package_public}. See the documented integration tiers before configuring your client.`} />
</BaseLayout>
