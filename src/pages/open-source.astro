---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTASection from '../components/CTASection.astro';
import { config } from '../lib/config';

// OSS-beta positioning. Pro-tier framing is parked during beta — only OSS
// features that ship today are surfaced here.
const ossHighlights = [
  { title: 'Full Prompt Packing pipeline', body: 'Deterministic Prompt Packing for every request — selects, reduces, and structures context into a Pak before it hits the wire. The OSS package is the full pipeline, not a limited demo.' },
  { title: 'Local proxy, no cloud',         body: 'Runs at 127.0.0.1. Byte-preserved passthrough; your prompts and credentials stay in your environment and the provider flow you already use.' },
  { title: 'Client integrations',           body: 'See the client tiers below.' },
  { title: 'Savings Ledger + Spend Guard',  body: 'Local telemetry store, A/B replay, 50 built-in compression profiles, vault indexing and search, and a pre-send circuit breaker (Spend Guard) that blocks runaway requests before they reach the provider.' },
];
---
<BaseLayout title="Open source — TokenPak" description="TokenPak's OSS core is Apache 2.0 licensed. Install in one command.">
  <section class="mx-auto max-w-prose-wide px-6 pt-16 pb-8">
    <p class="text-caption text-tp-mute uppercase tracking-wide mb-2">Open source · beta</p>
    <h1>TokenPak is open source.</h1>
    <p class="mt-4 text-body text-tp-ink max-w-prose">
      The proxy, Prompt Packing engine, client integrations, local dashboard,
      Savings Ledger, and Spend Guard are <strong>Apache 2.0 licensed</strong> and
      run entirely on your machine. This is the beta surface — features that
      ship today, no marketing of anything that doesn't.
    </p>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-6">
    <h2>Install</h2>
    <div class="mt-4 grid grid-cols-1 gap-4">
      <CodeBlock language="bash" title="pip">
{`pip install ${config.package_public}
${config.package_public} setup`}
      </CodeBlock>
    </div>
    <p class="mt-3 text-small text-tp-mute">
      One command to install, one to set up. The setup wizard detects API keys,
      picks a compression profile, and starts the proxy on
      <code class="font-mono">127.0.0.1:8766</code>.
    </p>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>What's in the OSS beta</h2>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {ossHighlights.map((card) => <FeatureCard title={card.title} body={card.body} />)}
    </div>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>What ships today</h2>
    <p class="mt-2 text-tp-mute">Client support, by how far we can actually vouch for it.</p>
    <dl class="mt-6 space-y-4">
      <div>
        <dt class="font-semibold">First-class integrations</dt>
        <dd class="text-tp-mute">Codex and Claude Code. Each ships a dedicated launcher and a proxy path built for that client.</dd>
      </div>
      <div>
        <dt class="font-semibold">Tested SDK adapters</dt>
        <dd class="text-tp-mute">OpenAI SDK, Anthropic SDK, LiteLLM.</dd>
      </div>
      <div>
        <dt class="font-semibold">Compatibility targets — not yet verified</dt>
        <dd class="text-tp-mute">Cursor, Cline, Continue, Aider. Expected to work by pointing the client's base URL at the proxy, but no dedicated integration surface and no test coverage.</dd>
      </div>
    </dl>
    <p class="mt-4 text-small text-tp-mute">Scored recall ranking, the capture pipeline and autonomous Pak injection are Pro surfaces, not part of the free core.</p>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>Source + package</h2>
    <ul class="mt-4 space-y-2">
      <li><a href={config.github_repo}>GitHub — {config.github_repo.replace('https://github.com/', '')}</a></li>
      <li><a href={config.pypi_repo}>PyPI — {config.package_public}</a></li>
      <li><a href={config.cta_urls.read_docs}>Docs — {config.docs_base_url}</a></li>
    </ul>
  </section>

  <CTASection heading="Ready to try it?" body={`${config.package_public} runs entirely on your machine. Nothing to sign up for.`} />
</BaseLayout>
