---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../lib/config';

// This page makes no feature claims about other projects. It names the
// categories TokenPak overlaps with and links each tool to its own
// documentation. TokenPak's own statements are limited to what the
// open-source package ships today.

const diff = [
  {
    title: 'Local-first',
    body:
      'The proxy and request records run locally. Provider-bound prompts and credentials still travel to the provider you configure; TokenPak operates no cloud relay. See the privacy page for logging details.',
  },
  {
    title: 'A reproducible fixture benchmark for explicit compression',
    body:
      'The headline benchmark exercises a fixed agent-style fixture (`make benchmark-headline`). Its reduction is not a default-proxy savings receipt; applicable CI paths select the benchmark.',
  },
  {
    title: 'Causal cost attribution + a pre-send circuit breaker',
    body:
      "Savings attribution is causal — proxy-caused hits are never mixed with provider-side cache hits. Spend Guard holds a request that would exceed its limit before it reaches the provider and returns HTTP 402 with a release directive. By default the limit is the model's context window; dollar and rolling caps are opt-in.",
  },
];

// Each entry links to the project's own documentation.
const overlaps = [
  {
    kind: 'Gateways and routers',
    overlap: 'Routing',
    tools: [
      { name: 'LiteLLM', href: 'https://docs.litellm.ai/' },
      { name: 'OpenRouter', href: 'https://openrouter.ai/docs' },
      { name: 'Portkey', href: 'https://portkey.ai/docs' },
    ],
  },
  {
    kind: 'Observability tools',
    overlap: 'Measurement',
    tools: [
      { name: 'Helicone', href: 'https://docs.helicone.ai/' },
      { name: 'Langfuse', href: 'https://langfuse.com/docs' },
      { name: 'LangSmith', href: 'https://docs.smith.langchain.com/' },
    ],
  },
];
---
<BaseLayout
  title="How TokenPak compares — TokenPak"
  description="How TokenPak relates to LLM gateways and observability tools: where it overlaps with them, what it adds, and why you can run both."
>
  <section class="mx-auto max-w-prose-wide px-6 pt-16 pb-8">
    <p class="text-caption text-tp-mute uppercase tracking-wide mb-2">Compare</p>
    <h1>How TokenPak compares.</h1>
    <p class="mt-6 text-body">
      TokenPak overlaps with gateways on routing and with observability tools on
      measurement. It adds local request records, session economics and Spend
      Guard, and runs beside them. Run both.
    </p>
    <p class="mt-4 text-small text-tp-mute">
      This page does not compare features across projects. Each tool below links
      to its own documentation, which is the place to check what it offers today.
    </p>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>Where TokenPak is different</h2>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
      {diff.map((d) => (
        <div class="rounded-card border border-tp-rule p-5 bg-tp-paper">
          <div class="font-semibold text-tp-ink">{d.title}</div>
          <p class="mt-2 text-small text-tp-mute">{d.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>Where TokenPak overlaps</h2>
    <p class="mt-2 text-small text-tp-mute">
      Tools you may already run, grouped by the job they overlap with TokenPak on.
    </p>
    <div class="mt-6 overflow-x-auto rounded-card border border-tp-rule" role="region" aria-label="Tools TokenPak overlaps with" tabindex="0">
      <table class="w-full text-small">
        <thead class="bg-tp-paper">
          <tr>
            <th class="text-left font-semibold px-4 py-3">Tool type</th>
            <th class="text-left font-semibold px-4 py-3">Overlaps with TokenPak on</th>
            <th class="text-left font-semibold px-4 py-3">Project documentation</th>
          </tr>
        </thead>
        <tbody>
          {overlaps.map((o) => (
            <tr class="border-t border-tp-rule align-top">
              <td class="px-4 py-3 text-tp-ink font-medium">{o.kind}</td>
              <td class="px-4 py-3 text-tp-mute">{o.overlap}</td>
              <td class="px-4 py-3 text-tp-ink">
                {o.tools.map((t, i) => (
                  <>
                    <a href={t.href}>{t.name}</a>{i < o.tools.length - 1 ? ', ' : ''}
                  </>
                ))}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>Reproduce the headline benchmark</h2>
    <p class="mt-2 text-body">
      Run <code class="font-mono">make benchmark-headline</code> to inspect a fixed
      agent-style fixture. This is an explicit benchmark, not evidence that the
      default proxy shortens provider conversation turns. Clone the OSS repo and run:
    </p>
    <pre class="mt-4 rounded-card border border-tp-rule p-4 bg-tp-paper font-mono text-small overflow-x-auto" tabindex="0" role="region" aria-label="Quick-start commands"><code>git clone {config.github_repo}
cd tokenpak
make dev
make benchmark-headline</code></pre>
    <p class="mt-4 text-small text-tp-mute">
      The owning CI workflow selects this benchmark for applicable changed paths.
      Its fixture measurements do not establish savings on your requests. Keep
      observed provider cache reuse separate from TokenPak context reduction.
    </p>
  </section>

  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <div class="rounded-card border border-tp-rule p-8 bg-tp-paper">
      <h2>Spot something wrong?</h2>
      <p class="mt-2 text-body">
        If something on this page is out of date or inaccurate, write to
        <a href="mailto:hello@tokenpak.ai">hello@tokenpak.ai</a>.
      </p>
    </div>
  </section>
</BaseLayout>
