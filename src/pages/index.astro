---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTASection from '../components/CTASection.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import { latestRelease } from '../lib/releases';
import DocLinkCard from '../components/DocLinkCard.astro';
import { docsLinks } from '../lib/docs-links';
import DiagramRequestFlow from '../components/DiagramRequestFlow.astro';
import DiagramWhereItFits from '../components/DiagramWhereItFits.astro';

const latest = latestRelease();
const featuredDocs = docsLinks.slice(0, 3);

// Six-card capability grid. Render as a grid, NEVER an arrow pipeline.
const pillars = [
  { title: 'Pack',     body: 'Explicit context tools can reduce eligible content. The default proxy preserves conversation turns and can report zero tokens saved.' },
  { title: 'Route',    body: 'Configure routing policies and inspect observe-mode records. Automatic model changes and fallback enforcement are not active by default.' },
  { title: 'Reuse',    body: 'Use local vault recall and read-only Pak inspection. Broader Pak reuse is a separate capability with its own availability requirements.' },
  { title: 'Guard',    body: 'Spend and safety guardrails run as a side-channel gatehouse across every request.' },
  { title: 'Dispatch', body: 'Coordinate scoped, multi-step and multi-agent work. Preview (alpha) — not yet in a published release.' },
  { title: 'Record',   body: 'Inspect locally recorded requests, observed usage and available cost attribution. Missing coverage remains visible; records do not guarantee savings.' },
];

// "Where TokenPak fits" — 3-row comparison. Observability row uses the interim
// safe wording (no integration arrow); MCP row uses "composes with".
const fitsRows = [
  { type: 'Gateways / routers',     overlap: 'routing',                    adds: 'explicit context tools + local request records',                together: 'Run both.' },
  { type: 'Observability tools',    overlap: 'measurement',                adds: 'explicit context tools + local attribution records',    together: 'Run both.' },
  { type: 'MCP-based workflows',    overlap: 'ecosystem coordination',     adds: 'a semantic contract (TIP) for packing, routing, cost, telemetry', together: 'Composes.' },
];
---
<BaseLayout title="TokenPak — open logistics layer for AI context">
  {/* Live hero preserved intentionally — do not overwrite. */}
  <Hero />

  <!-- Narrative band -->
  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>TokenPak doesn't replace your AI stack.</h2>
    <p class="mt-2 text-tp-mute">
      It adds the missing logistics layer: packing, routing, reusable context,
      guardrails, orchestration, and per-request records.
    </p>
  </section>

  <!-- Six-card capability grid (grid, never arrows) -->
  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>Six capabilities</h2>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {pillars.map((p) => <FeatureCard title={p.title} body={p.body} />)}
    </div>
  </section>

  <!-- Diagram A — request flow -->
  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>How a request flows</h2>
    <p class="mt-2 text-tp-mute">The default path forwards conversation turns without shortening them. Explicit context tools and configured guards have separate roles.</p>
    <div class="mt-6">
      <DiagramRequestFlow />
    </div>
  </section>

  <!-- "Where TokenPak fits" — collapsed by default; full detail lives on /compare -->
  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>Where TokenPak fits</h2>
    <p class="mt-2 text-tp-mute">
      TokenPak overlaps with tools you may already run — and adds a layer they
      don't. Run them together.
    </p>

    <details class="mt-4 group">
      <summary class="cursor-pointer text-tp-ink font-medium rounded-input focus-visible:outline focus-visible:outline-2 focus-visible:outline-tp-accent">
        How it sits alongside gateways, observability tools, and MCP
      </summary>

      <div class="mt-6">
        <DiagramWhereItFits />
      </div>

      <div class="mt-6 overflow-x-auto rounded-card border border-tp-rule" role="region" aria-label="Where TokenPak fits alongside other tools" tabindex="0">
      <table class="w-full text-small">
        <thead class="bg-tp-paper">
          <tr>
            <th class="text-left font-semibold px-4 py-3">Tool type</th>
            <th class="text-left font-semibold px-4 py-3">Overlaps on</th>
            <th class="text-left font-semibold px-4 py-3">TokenPak adds</th>
            <th class="text-left font-semibold px-4 py-3 w-28">Together?</th>
          </tr>
        </thead>
        <tbody>
          {fitsRows.map((r) => (
            <tr class="border-t border-tp-rule align-top">
              <td class="px-4 py-3 text-tp-ink font-medium">{r.type}</td>
              <td class="px-4 py-3 text-tp-mute">{r.overlap}</td>
              <td class="px-4 py-3 text-tp-ink">{r.adds}</td>
              <td class="px-4 py-3 text-tp-mute">{r.together}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>

      <p class="mt-3 text-small text-tp-mute">
        <a href="/compare">Full comparison</a>
      </p>
    </details>
  </section>

  <!-- Savings posture (qualitative only — no numeric % on v1) -->
  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>Savings</h2>
    <p class="mt-2 text-tp-ink">
      The default proxy preserves conversation turns and does not promise token
      savings. Explicit compression tools can reduce eligible content. Provider
      cache reuse is measured separately from product-attributed reduction;
      inspect your recorded usage and its coverage before drawing conclusions.
    </p>
  </section>

  <!-- OSS vs Pro -->
  <section class="mx-auto max-w-prose-wide px-6 py-8">
    <h2>Open source &amp; Pro</h2>
    <p class="mt-2 text-tp-ink">
      TokenPak's core is open source (Apache-2.0). Pro adds team dashboards,
      advanced routing, and enterprise controls.
    </p>
    <p class="mt-2 text-small text-tp-mute">
      Pro is delivered as the <code>tokenpak-paid</code> package via a separate index.
    </p>
  </section>

  {latest && (
    <section class="mx-auto max-w-prose-wide px-6 py-8">
      <h2>Latest release</h2>
      <div class="mt-6">
        <ReleaseCard release={latest} />
      </div>
    </section>
  )}

  {featuredDocs.length > 0 && (
    <section class="mx-auto max-w-prose-wide px-6 py-8">
      <h2>Documentation</h2>
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {featuredDocs.map((link) => <DocLinkCard link={link} />)}
      </div>
      <p class="mt-3 text-small text-tp-mute">
        More at <a href="https://docs.tokenpak.ai">docs.tokenpak.ai</a>.
      </p>
    </section>
  )}

  <CTASection
    heading="Try it locally."
    body="pip install tokenpak && tokenpak setup — then point your AI client at the local proxy. No cloud component; credentials stay in your environment and provider flow."
    showPrimary={false}
  />
</BaseLayout>
